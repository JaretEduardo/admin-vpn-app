# Copiar a .env y completar con valores reales (nunca versionar .env).
#
# DATABASE_URL: cadena de conexión MySQL usada por Prisma.
# Formato: mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# En despliegue (Coolify/AWS), esta variable la inyecta Coolify en runtime,
# apuntando a la red interna donde vive el recurso MySQL administrado por
# Coolify — nunca se versiona un valor real aquí.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
